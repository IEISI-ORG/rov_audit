#!/bin/bash

# Main Audit
echo "RUNNING GLOBAL AUDIT (V22)..."
python3 rov_no_scrape_v22.py                | aha --black | tee reports/rov_audit_v22.html

echo "ANALYSIS"
python3 analyze_roa_signing_v2.py           | aha --black | tee reports/analyze_roa_signing.html
python3 analyze_herd_immunity_v2.py         | aha --black | tee reports/analyze_herd_immunity.html
python3 analyze_roa_strategy_v3.py          | aha --black | tee reports/analyze_roa_strategy.html
python3 analyze_aspa_readiness_v2.py        | aha --black | tee reports/analyze_aspa_readiness.html

echo "BASIC STATS"
python3 statistics_v6.py                    | aha --black | tee reports/statistics.html

echo "CCTLD DEEP DIVES"
for cc in NP BT BD IN PK AU NZ CN JP ID BR CL CO PG FJ CK PF NU WS SB NC GU AS MP KI MH FM PW NR TV TK TO VU WF FR DE GR ES PT ZA NG EG MA KE CI; do
    echo "Processing $cc..."
    python3 analyze_country_deep_dive_v2.py $cc | aha --black | tee reports/${cc,,}_report.html
done

FILES=reports/*.html
for f in $FILES; do
    filename="${f%.*}"
    echo "Converting $f to $filename.md"
    pandoc "$f" -t markdown -o "$filename.md"
done
