#!/bin/bash

wget --timestamping --output-document=latest-bview.gz http://data.ris.ripe.net/rrc00/latest-bview.gz

bgpdump -m latest-bview.gz | ./bgp-extractor -input /dev/stdin -output output -workers 16

./cone-calculator -input output/relationships.csv -output final_as_rank.csv -top 0

# Sync RPKI timeseries for all transit networks to detect regressions
python3 sync_transit_timeseries.py

# Bulk ROA Sync (Go-powered, 500x faster than old version)
python3 do_roa_sync.py

# Pack data for high-performance analysis
echo "[*] Packing ASN data for analysis..."
python3 pack_asn_data.py
